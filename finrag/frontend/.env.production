# 生产环境变量
VITE_APP_TITLE=FinRAG · 金融制度智能问答系统

# 生产由 nginx / FastAPI 同源转发 /api/v1，保持与后端 api_prefix 一致
VITE_API_BASE_URL=/api/v1

# 代理目标（仅 `vite preview` 时生效）
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 后端 main.py 将 frontend/dist 挂载在 /app，故生产基址为 /app/
# 若改用 nginx 根路径部署，请把该值改回 /
VITE_PUBLIC_BASE=/app/

# 生产环境允许更长的模型生成等待时间
VITE_REQUEST_TIMEOUT=120000

VITE_HEALTH_INTERVAL=60000
