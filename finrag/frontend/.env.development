# 开发环境变量（Vite 仅暴露 VITE_ 前缀的变量给客户端代码）
VITE_APP_TITLE=FinRAG · 金融制度智能问答系统

# 前端请求基址：由 vite dev server 代理到后端，无需处理跨域
VITE_API_BASE_URL=/api/v1

# 代理目标：本地 FastAPI 服务地址
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 部署基址（开发为根路径）
VITE_PUBLIC_BASE=/

# 单次请求超时（毫秒），问答涉及大模型生成，预留充足时间
VITE_REQUEST_TIMEOUT=60000

# 前端轮询健康状态的间隔（毫秒）
VITE_HEALTH_INTERVAL=30000
