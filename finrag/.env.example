# ============================================================================
#  FinRAG · 基于 RAG 的金融制度类知识问答系统  —— 环境变量模板
#  用法：cp .env.example .env  然后按需修改
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 应用基础配置
# ---------------------------------------------------------------------------
APP_NAME=FinRAG
APP_ENV=dev                       # dev / test / prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ---------------------------------------------------------------------------
# 2. 通义千问（DashScope OpenAI 兼容模式）
#    申请地址：https://bailian.console.aliyun.com/  -> API-KEY 管理
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus                 # 可选 qwen-turbo / qwen-max / qwen2.5-72b-instruct
QWEN_EMBEDDING_MODEL=text-embedding-v3    # 维度可选 1024 / 768 / 512
QWEN_EMBEDDING_DIM=1024
QWEN_TEMPERATURE=0.1
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=2
# 说明：系统生产链路严格为「Milvus + 通义千问」，不提供替代向量库或替代 LLM。
#      单元测试通过依赖注入使用 tests/fakes.py 中的测试替身，不影响生产链路。

# ---------------------------------------------------------------------------
# 3. MySQL（结构化数据：制度文档、条文、问答历史、收藏）
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=finrag
MYSQL_PASSWORD=finrag_pwd
MYSQL_DB=finrag
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_ECHO=false

# 仅 Docker 编排使用：docker-compose.yml 用该口令初始化 mysql:8.0 容器。
# 本地直连已有 MySQL 时无需关心此项。
MYSQL_ROOT_PASSWORD=root_pwd_change_me

# ---------------------------------------------------------------------------
# 4. Milvus（向量数据库：条文 embedding）
# ---------------------------------------------------------------------------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=finrag_clause
MILVUS_INDEX_TYPE=HNSW                 # HNSW / IVF_FLAT / IVF_SQ8
MILVUS_METRIC_TYPE=COSINE              # COSINE / IP / L2
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF_SEARCH=64
MILVUS_CONSISTENCY_LEVEL=Bounded

# ---------------------------------------------------------------------------
# 5. 文本切分与检索参数
# ---------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=5
RETRIEVE_CANDIDATE_K=20
RETRIEVE_MODE=hybrid                   # vector / bm25 / hybrid
RRF_K=60
# 向量相似度下限：低于该值的候选视为「不相关」直接丢弃。
# 宁可回答「未检索到相关规定」，也不拿不相关条文让大模型硬凑答案。
MIN_VECTOR_SCORE=0.30
VERIFY_ANSWER_ACCURACY_TARGET=0.85
RESPONSE_TIME_BUDGET_MS=2000

# ---------------------------------------------------------------------------
# 6. OCR（图片/扫描件解析）
# ---------------------------------------------------------------------------
OCR_ENABLED=true
TESSERACT_CMD=                         # 例：C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=chi_sim+eng
OCR_DPI=300
PDF_IMAGE_FALLBACK=true                # PDF 无文本层时回退为图片 OCR

# ---------------------------------------------------------------------------
# 7. 上传与安全
# ---------------------------------------------------------------------------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx,.png,.jpg,.jpeg,.bmp,.tif,.tiff
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
